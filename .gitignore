token.json
.env
.env.*
/mcp-publisher

# Editor and tool scratch files. Listed before the first `git add -A`,
# because an editor's temp file reaches a public repository that way and
# is not visible at commit time.
*.swp
*.swo
*~
.#*
\#*\#
*.orig
*.rej
*.bak
*.tmp
.DS_Store
Thumbs.db
.idea/
.vscode/
/.claude/
